# 1. СЕТЕВЫЕ НАСТРОЙКИ СЕРВЕРА NTFY
# Укажите корневой URL-адрес вашего ntfy-сервера.
# Для публичного сервера: https://ntfy.sh
# Для приватного сервера: https://yourcompany.com (или http://IP_сервера:8080)
NTFY_HOST=https://company.com

# 2. АВТОРИЗАЦИЯ (ДЛЯ ПРИВАТНОГО СЕРВЕРА)
# Токен доступа (Access Token) для шлюза, сгенерированный внутри контейнера ntfy.
# Команда для генерации: docker exec -it ntfy-server ntfy token add push_bridge_user
# Если используется публичный сервер ntfy.sh - оставьте поле ПУСТЫМ.
NTFY_AUTH_TOKEN=tk_abcdef1234567890abcdef

# 3. СТРУКТУРИРОВАНИЕ ТОПИКОВ
# Кастомный префикс, который будет подставляться в начало имени каждого топика ntfy.
# Помогает отделить уведомления этого шлюза от других подписок в приложении.
# Пример итогового топика: secure_corp_push_42
NTFY_TOPIC_PREFIX=secure_corp_push


# ==============================================================================
# 1. NTFY-SERVER NETZWERKEINSTELLUNGEN
# Geben Sie die Basis-URL Ihres ntfy-Servers an.
# Für den öffentlichen Server: https://ntfy.sh
# Für einen privaten Server: https://ihrefirma.de (oder http://SERVER_IP:8080)
# ==============================================================================
NTFY_HOST=https://company.com

# ==============================================================================
# 2. AUTHENTIFIZIERUNG (NUR FÜR PRIVATE SERVER)
# Das Zugriffs-Token (Access Token) für das Gateway, generiert im ntfy-Docker-Container.
# Befehl zur Generierung: docker exec -it ntfy-server ntfy token add push_bridge_user
# Wenn Sie den öffentlichen Server ntfy.sh nutzen, lassen Sie dieses Feld LEER.
# ==============================================================================
NTFY_AUTH_TOKEN=tk_abcdef1234567890abcdef

# ==============================================================================
# 3. TOPIC-STRUKTURIERUNG
# Ein benutzerdefiniertes Präfix, das dem Namen jedes ntfy-Topics vorangestellt wird.
# Hilft dabei, die Benachrichtigungen dieses Gateways von anderen Abonnements in der App zu trennen.
# Beispiel für den finalen Topic-Namen: secure_corp_push_42
# ==============================================================================
NTFY_TOPIC_PREFIX=secure_corp_push
